{
  "name": "frontend",
  "version": "0.14.4",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=json-summary --coverage.reporter=json --coverage.include='src/**/*.ts' --coverage.include='src/**/*.tsx' --coverage.exclude='src/**/*.test.ts' --coverage.exclude='src/**/*.test.tsx' --coverage.exclude='src/test/**'",
    "typecheck": "tsc --noEmit",
    "full:smoke": "node scripts/full-product-ui-smoke.mjs",
    "pilot:smoke": "node scripts/pilot-ui-smoke.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/postcss": "^4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.12.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.1",
    "vis-network": "^10.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.1",
    "postcss": "8.5.24",
    "typescript": "^6",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "postcss": "8.5.24",
    "undici": "8.9.0",
    "uuid": "^14.0.0"
  },
  "resolutions": {
    "brace-expansion": "5.0.9",
    "postcss": "8.5.24",
    "undici": "8.9.0"
  }
}
